# Example Pacioli scope manifest.
# Copy this to your IaC repo as `.pacioli/scope.yaml` and customize:
#   mkdir -p .pacioli
#   cp examples/scope.yaml.example ./.pacioli/scope.yaml
#
# The required root key is `projects:`. Each project is a logical grouping
# (usually a Terraform module); the scanner walks env/<project>/<env>/ for
# every project and environment whose status is `in_scope`.
#
# `pending` and `excluded` are never scanned and do not enter a newly
# generated report. `reason` is OPTIONAL for both — the parser accepts an
# entry without one — but a non-blank reason is strongly recommended so
# the audit trail in Git explains why the env is out of scope. The scope
# file lives in YOUR IaC repo (not in Pacioli) because the audit boundary
# is tenant-specific.

projects:
  - project: myapp
    description: My application infrastructure
    status: in_scope
    envs:
      - name: prod
        status: in_scope
      - name: staging
        status: pending
        reason: Data-classification attestation is awaiting Security approval.
  - project: myapp-data
    description: Data layer for myapp
    status: in_scope
    envs:
      - name: prod
        status: in_scope
  - project: shared-services
    description: Shared services (logging, monitoring, identity)
    status: excluded
    reason: Shared platform is assessed under a separate audit boundary.
    envs:
      - name: prod
        status: in_scope
