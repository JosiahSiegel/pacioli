# Pacioli baseline — repo-wide suppressions for known/accepted findings.
# Copy this to your IaC repo as `pci_baseline.yaml` and customize.
#
# Schema:
#   version:          schema version (always 1)
#   verified_against: ISO date when this file was generated
#   suppressions:     list of suppression entries (empty by default)
#
# Each suppression entry:
#   check_id, resource_pattern, justification, compensating_control,
#   owner, ticket_id, expires_on
#
# The aggregator suppresses ONLY if expires_on >= today AND owner != "TBD".
# Stubs (TBD*) NEVER suppress findings.
#
# Example — populate after first scan via `pacioli baseline init`:
# suppressions:
#   - check_id: CKV_AZURE_59
#     resource_pattern: "azurerm_storage_account.example"
#     justification: "Legacy resource, migration planned"
#     compensating_control: "WAF rule abc123"
#     owner: "team@example.com"
#     ticket_id: "TICKET-123"
#     expires_on: "2026-12-31"
#
# Next steps:
#   1. Run `pacioli scan` to generate findings
#   2. Run `pacioli baseline init <run_dir>` to seed stub suppressions
#   3. Triage top-stubs by hit_count and populate the 7 fields

version: 1
verified_against: 2026-01-01
suppressions: []
