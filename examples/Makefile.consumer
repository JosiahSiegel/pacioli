# Pacioli Makefile.consumer
# =============================================================================
# Copy this file into your Terraform repo as `Makefile.pacioli` (or merge
# it into your existing Makefile). Update PACIOLI_DIR to point at your
# local Pacioli checkout (or use a git submodule / pip install).
#
# Requires the `pacioli` CLI on $PATH:
#   pip install -e $(PACIOLI_DIR)         # installs the `pacioli` command
#   # Legacy alias (pre-standalone CLI): `pacioli-scan` is also accepted.
# =============================================================================

# Path to the Pacioli installation (used for `make test` and as the default
# `pip install -e` source). Override at the command line:
#   make -f Makefile.pacioli scan PACIOLI_DIR=...
PACIOLI_DIR ?= ../pacioli

# Which Pacioli binary to invoke. Defaults to `pacioli` (the standalone
# CLI installed by `pip install -e $(PACIOLI_DIR)`). The legacy wrapper
# `pacioli-scan` is also accepted; set PACIOLI_BIN=pacioli-scan to use it.
PACIOLI_BIN ?= pacioli

# Scope + baseline live in THIS repo (consumer-owned).
SCOPE_FILE ?= pci_scope.yaml
BASELINE_FILE ?= pci_baseline.yaml

# Mapping pack to use. Default: PCI DSS v4.0.1 from the pacioli install.
MAPPING_FILE ?= $(PACIOLI_DIR)/mappings/pci_dss_4.0.1.yaml

# Optional: Azure storage account for state-blob scan tier.
# Set to your tenant's storage account name.
PACIOLI_STATE_STORAGE_ACCOUNT ?=
export PACIOLI_STATE_STORAGE_ACCOUNT

# Tell the scanner where to find this repo.
export PACIOLI_TARGET_REPO := $(CURDIR)

.PHONY: scan scan-plan scan-state scan-gate scan-audit scan-baseline-init scan-cleanup scan-fix-list test help

help:
	@echo "Pacioli scan targets:"
	@echo "  make scan                    - Source-only scan (no terraform, no Azure calls)"
	@echo "  make scan-plan               - + terraform plan layer (needs Azure auth)"
	@echo "  make scan-state              - + state blob download + drift diff"
	@echo "  make scan-gate               - CI gate (exits non-zero on HIGH/CRITICAL)"
	@echo "  make scan-audit              - Re-emit a prior report from the pacioli-reports archive"
	@echo "  make scan-baseline-init      - Generate stub baseline entries from a run"
	@echo "  make scan-fix-list           - Re-emit fix_list.md from a run"
	@echo "  make scan-cleanup            - Post-scan safety cleanup (no-op stub; manual if needed)"
	@echo "  make test                    - Run the pacioli test suite"
	@echo ""
	@echo "Common args: PROJECT=<p> ENV=<e> LABEL=<l> RUN_DIR=.checkov/<run_id>"
	@echo "Audit args:  RUN_ID=<run_id> OUT=<path>  (default: --latest, no out copy)"
	@echo ""
	@echo "Binary:    PACIOLI_BIN=$(PACIOLI_BIN)  (override to pacioli-scan for the legacy wrapper)"

scan:
	@$(PACIOLI_BIN) scan --target-repo $(CURDIR) \
		$(if $(MAPPING_FILE),--mapping $(MAPPING_FILE)) \
		$(if $(PROJECT),--project $(PROJECT)) \
		$(if $(ENV),--env $(ENV)) \
		$(if $(LABEL),--label $(LABEL))

scan-plan:
	@$(PACIOLI_BIN) scan --target-repo $(CURDIR) --tier plan \
		$(if $(MAPPING_FILE),--mapping $(MAPPING_FILE)) \
		$(if $(PROJECT),--project $(PROJECT)) \
		$(if $(ENV),--env $(ENV))

scan-state:
	@$(PACIOLI_BIN) scan --target-repo $(CURDIR) --tier state \
		$(if $(MAPPING_FILE),--mapping $(MAPPING_FILE)) \
		$(if $(PROJECT),--project $(PROJECT)) \
		$(if $(ENV),--env $(ENV))

scan-gate:
	@$(PACIOLI_BIN) gate --target-repo $(CURDIR) \
		$(if $(MAPPING_FILE),--mapping $(MAPPING_FILE)) \
		$(if $(PROJECT),--project $(PROJECT)) \
		$(if $(ENV),--env $(ENV))

scan-audit:
	@$(PACIOLI_BIN) audit \
		$(if $(RUN_ID),--run-id $(RUN_ID),--latest) \
		$(if $(OUT),--out $(OUT))

scan-baseline-init:
	@$(PACIOLI_BIN) baseline init \
		$(if $(RUN_DIR),--run-dir $(RUN_DIR)) \
		$(if $(BASELINE_FILE),--baseline $(BASELINE_FILE))

scan-fix-list:
	@$(PACIOLI_BIN) scan --target-repo $(CURDIR) --emit-fix-list \
		$(if $(RUN_DIR),--run-dir $(RUN_DIR))

scan-cleanup:
	@echo "scan-cleanup is a no-op under the standalone CLI."
	@echo "The legacy az storage account network-rule whitelist auto-revert is no longer performed."
	@echo "If you need manual cleanup, run: az storage account network-rule list ..."

test:
	@cd $(PACIOLI_DIR) && make test
