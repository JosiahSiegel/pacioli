# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.tox/

# Local virtualenvs
.venv/
venv/
env/

# Test artifacts
tests/__pycache__/
tests/.pytest_cache/

# Build artifacts
build/
dist/

# Node (jsdom for e2e tests, optional)
node_modules/

# Local scan output (not committed; CI produces these in build artifacts)
.checkov/
*.sarif
report.html
tfplan.binary
plan.json
coverage_matrix.csv

# Pacioli global cache (per-user run metadata; never committed)
.pacioli/runs/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

.omo/

# Generated mapping-pack copies (single source of truth: mappings/ at repo root).
# scanner/mappings/<name>.yaml is produced by `make sync-mappings` from
# mappings/<name>.yaml so the wheel install ships the pack under the
# `scanner` package for the importlib.resources fallback in
# scanner/paths.py:resolve_mapping(). Do NOT commit hand-edits here —
# edit mappings/<name>.yaml at the repo root and re-run `make sync-mappings`.
scanner/mappings/*.yaml
